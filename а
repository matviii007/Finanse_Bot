import os
import io
import datetime
from dotenv import load_dotenv

from aiogram import Bot, Dispatcher, F, types
from aiogram.filters import CommandStart, Command
from aiogram.fsm.context import FSMContext
from aiogram.fsm.state import State, StatesGroup
from aiogram.fsm.storage.memory import MemoryStorage
from aiogram.utils.keyboard import InlineKeyboardBuilder, ReplyKeyboardBuilder
import asyncpg
import openpyxl

load_dotenv()

BOT_TOKEN = os.getenv("BOT_TOKEN")
DATABASE_URL = os.getenv("DATABASE_URL")

bot = Bot(token=BOT_TOKEN)
dp = Dispatcher(storage=MemoryStorage())
db_pool = None

# --- ТЕКСТИ ТА ЛОКАЛІЗАЦІЯ ---
TEXTS = {
    'uk': {
        'start': "Привіт! Я твій фінансовий бот 📊\nОберіть дію в меню нижче:",
        'select_lang': "Оберіть мову / Select language:",
        'lang_set': "Мову змінено на українську! 🇺🇦",
        'enter_amount': "Введіть суму (наприклад, 150 або 49.99):",
        'enter_comment': "Введіть коментар/категорію (або натисніть 'Пропустити'):",
        'skip': "Пропустити",
        'err_amount': "Будь ласка, введіть коректне число!",
        'err_too_big': "Сума занадто велика! Введіть значення менше 100 000 000.",
        'success': "Запис успішно збережено! ✅",
        'no_data': "У вас поки немає збережених транзакцій.",
        'btn_income': "➕ Дохід",
        'btn_expense': "➖ Витрата",
        'btn_stats': "📈 Статистика",
        'btn_export': "📁 Експорт в Excel",
        'btn_lang': "🌐 Мова / Language",
        'cancel': "Скасувати"
    },
    'en': {
        'start': "Hello! I am your finance tracking bot 📊\nChoose an option below:",
        'select_lang': "Select language / Оберіть мову:",
        'lang_set': "Language changed to English! 🇬🇧",
        'enter_amount': "Enter amount (e.g. 150 or 49.99):",
        'enter_comment': "Enter a comment/category (or press 'Skip'):",
        'skip': "Skip",
        'err_amount': "Please enter a valid number!",
        'err_too_big': "Amount is too large! Enter a value under 100,000,000.",
        'success': "Transaction saved successfully! ✅",
        'no_data': "You don't have any saved transactions yet.",
        'btn_income': "➕ Income",
        'btn_expense': "➖ Expense",
        'btn_stats': "📈 Statistics",
        'btn_export': "📁 Export to Excel",
        'btn_lang': "🌐 Language / Мова",
        'cancel': "Cancel"
    }
}

class Form(StatesGroup):
    waiting_for_amount = State()
    waiting_for_comment = State()

# --- КЛАВІАТУРИ ---
def get_main_keyboard(lang: str = 'uk'):
    builder = ReplyKeyboardBuilder()
    builder.button(text=TEXTS[lang]['btn_income'])
    builder.button(text=TEXTS[lang]['btn_expense'])
    builder.button(text=TEXTS[lang]['btn_stats'])
    builder.button(text=TEXTS[lang]['btn_export'])
    builder.button(text=TEXTS[lang]['btn_lang'])
    builder.adjust(2, 2, 1)
    return builder.as_markup(resize_keyboard=True)

def get_lang_inline_keyboard():
    builder = InlineKeyboardBuilder()
    builder.button(text="Українська 🇺🇦", callback_data="set_lang_uk")
    builder.button(text="English 🇬🇧", callback_data="set_lang_en")
    builder.adjust(2)
    return builder.as_markup()

def get_skip_keyboard(lang: str = 'uk'):
    builder = ReplyKeyboardBuilder()
    builder.button(text=TEXTS[lang]['skip'])
    builder.button(text=TEXTS[lang]['cancel'])
    builder.adjust(1, 1)
    return builder.as_markup(resize_keyboard=True)

# --- БАЗА ДАНИХ ---
async def init_db():
    global db_pool
    db_pool = await asyncpg.create_pool(DATABASE_URL)
    async with db_pool.acquire() as conn:
        await conn.execute("""
            CREATE TABLE IF NOT EXISTS transactions (
                id SERIAL PRIMARY KEY,
                user_id BIGINT NOT NULL,
                amount NUMERIC(15, 2) NOT NULL,
                is_income BOOLEAN NOT NULL,
                comment TEXT,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            );
        """)

# --- ХЕНДЛЕРИ ---
@dp.message(CommandStart())
async def cmd_start(message: types.Message, state: FSMContext):
    data = await state.get_data()
    lang = data.get('user_lang', 'uk')
    await message.answer(TEXTS[lang]['start'], reply_markup=get_main_keyboard(lang))

@dp.message(Command("language"))
@dp.message(F.text.in_(["🌐 Мова / Language", "🌐 Language / Мова"]))
async def cmd_language(message: types.Message, state: FSMContext):
    data = await state.get_data()
    lang = data.get('user_lang', 'uk')
    await message.answer(TEXTS[lang]['select_lang'], reply_markup=get_lang_inline_keyboard())

@dp.callback_query(F.data.startswith("set_lang_"))
async def process_lang_change(callback: types.CallbackQuery, state: FSMContext):
    lang = callback.data.split("_")[-1]
    await state.update_data(user_lang=lang)
    await callback.message.edit_text(TEXTS[lang]['lang_set'])
    await callback.message.answer(TEXTS[lang]['start'], reply_markup=get_main_keyboard(lang))
    await callback.answer()

@dp.message(F.text.in_(["➕ Дохід", "➕ Income", "➖ Витрата", "➖ Expense"]))
async def start_transaction(message: types.Message, state: FSMContext):
    data = await state.get_data()
    lang = data.get('user_lang', 'uk')
    
    is_income = "Дохід" in message.text or "Income" in message.text
    await state.update_data(is_income=is_income)
    
    await message.answer(TEXTS[lang]['enter_amount'])
    await state.set_state(Form.waiting_for_amount)

@dp.message(Form.waiting_for_amount)
async def process_amount(message: types.Message, state: FSMContext):
    data = await state.get_data()
    lang = data.get('user_lang', 'uk')
    
    try:
        raw_text = message.text.replace(',', '.').strip()
        amount = float(raw_text)
        if amount <= 0:
            raise ValueError()
    except ValueError:
        await message.answer(TEXTS[lang]['err_amount'])
        return

    # Захист від NumericValueOutOfRangeError
    if amount >= 100_000_000:
        await message.answer(TEXTS[lang]['err_too_big'])
        return

    await state.update_data(amount=amount)
    await message.answer(TEXTS[lang]['enter_comment'], reply_markup=get_skip_keyboard(lang))
    await state.set_state(Form.waiting_for_comment)

@dp.message(Form.waiting_for_comment)
async def process_comment(message: types.Message, state: FSMContext):
    data = await state.get_data()
    lang = data.get('user_lang', 'uk')
    
    if message.text in ["Скасувати", "Cancel"]:
        await state.clear()
        await message.answer(TEXTS[lang]['start'], reply_markup=get_main_keyboard(lang))
        return

    comment = "" if message.text in ["Пропустити", "Skip"] else message.text
    user_id = message.from_user.id
    amount = data['amount']
    is_income = data['is_income']

    async with db_pool.acquire() as conn:
        await conn.execute("""
            INSERT INTO transactions (user_id, amount, is_income, comment)
            VALUES ($1, $2, $3, $4)
        """, user_id, amount, is_income, comment)

    await message.answer(TEXTS[lang]['success'], reply_markup=get_main_keyboard(lang))
    await state.clear()

@dp.message(F.text.in_(["📈 Статистика", "📈 Statistics"]))
async def show_stats(message: types.Message, state: FSMContext):
    data = await state.get_data()
    lang = data.get('user_lang', 'uk')
    
    async with db_pool.acquire() as conn:
        rows = await conn.fetch("""
            SELECT is_income, SUM(amount) as total 
            FROM transactions 
            WHERE user_id = $1 
            GROUP BY is_income
        """, message.from_user.id)

    if not rows:
        await message.answer(TEXTS[lang]['no_data'])
        return

    income = 0
    expense = 0
    for r in rows:
        if r['is_income']:
            income = r['total']
        else:
            expense = r['total']

    balance = income - expense
    
    if lang == 'en':
        text = f"📊 **Your Statistics**:\n\n➕ Total Income: `{income:.2f}`\n➖ Total Expense: `{expense:.2f}`\n💰 Balance: `{balance:.2f}`"
    else:
        text = f"📊 **Твоя статистика**:\n\n➕ Всього доходів: `{income:.2f}`\n➖ Всього витрат: `{expense:.2f}`\n💰 Баланс: `{balance:.2f}`"

    await message.answer(text, parse_mode="Markdown")

@dp.message(F.text.in_(["📁 Експорт в Excel", "📁 Export to Excel"]))
async def export_excel(message: types.Message, state: FSMContext):
    data = await state.get_data()
    lang = data.get('user_lang', 'uk')
    
    async with db_pool.acquire() as conn:
        rows = await conn.fetch("""
            SELECT amount, is_income, comment, created_at 
            FROM transactions 
            WHERE user_id = $1 
            ORDER BY created_at DESC
        """, message.from_user.id)

    if not rows:
        await message.answer(TEXTS[lang]['no_data'])
        return

    wb = openpyxl.Workbook()
    ws = wb.active
    ws.title = "Transactions"
    
    headers = ["Date", "Type", "Amount", "Comment"] if lang == 'en' else ["Дата", "Тип", "Сума", "Коментар"]
    ws.append(headers)

    for r in rows:
        t_type = ("Income" if lang == 'en' else "Дохід") if r['is_income'] else ("Expense" if lang == 'en' else "Витрата")
        date_str = r['created_at'].strftime("%Y-%m-%d %H:%M") if r['created_at'] else ""
        ws.append([date_str, t_type, float(r['amount']), r['comment'] or ""])

    file_stream = io.BytesIO()
    wb.save(file_stream)
    file_stream.seek(0)

    document = types.BufferedInputFile(file_stream.read(), filename="transactions.xlsx")
    await message.answer_document(document)

# --- ЗАПУСК ---
async def main():
    await init_db()
    await dp.start_polling(bot)

if __name__ == "__main__":
    import asyncio
    asyncio.run(main())
